[debug] [2026-08-30T18:35:20.425Z] <<< [apiv2][body] POST https://firebaserules.googleapis.com/v1/projects/compare-my-trip-8e035/rulesets {"name":"projects/compare-my-trip-8e035/rulesets/43a8205d-7027-4d2f-a13b-b933d0b87560","source":{"files":[{"content":"rules_version = '2';\n\nservice cloud.firestore {\n  match /databases/{database}/documents {\n    function isAdmin() {\n      return request.auth != null\n        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));\n    }\n\n    match /siteContent/homepage {\n      // Homepage content is public by design; only admins may publish it.\n      allow read: if true;\n      allow write: if isAdmin();\n    }\n\n    match /users/{userId} {\n      allow create, update, delete: if request.auth != null\n        && request.auth.uid == userId;\n      allow get: if (request.auth != null && request.auth.uid == userId)\n        || isAdmin();\n\n      // Customer contact details are visible only to explicitly authorized\n      // CRM accounts, never to every authenticated website customer.\n      allow list: if isAdmin();\n    }\n\n    match /newsletterSubscribers/{subscriberId} {\n      function validSubscription() {\n        return request.resource.data.keys().hasOnly(['email', 'subscribedAt'])\n          && request.resource.data.email is string\n          && request.resource.data.email.size() > 3\n          && request.resource.data.email.size() <= 254\n          && request.resource.data.email.matches('^[^\\\\s@]+@[^\\\\s@]+\\\\.[^\\\\s@]+$')\n          && request.resource.data.subscribedAt == request.time;\n      }\n\n      allow create: if validSubscription();\n      allow update: if validSubscription()\n        && request.resource.data.email == resource.data.email;\n      allow read, delete: if isAdmin();\n    }\n\n    match /admins/{adminId} {\n      // Admin membership is provisioned out-of-band in the Firebase console.\n      // Client applications can neither enumerate nor change this collection.\n      allow get: if request.auth != null && request.auth.uid == adminId;\n      allow list, create, update, delete: if false;\n    }\n\n    match /packages/{packageId} {\n      // Package products are public; only admins can manage them.\n      allow read: if true;\n      allow create, update, delete: if isAdmin();\n    }\n\n    match /{document=**} {\n      allow read, write: if false;\n    }\n  }\n}\n","name":"firestore.rules"}]},"createTime":"2026-08-30T18:35:20.285311Z","metadata":{"services":["cloud.firestore"]}}

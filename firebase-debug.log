[debug] [2026-08-31T03:03:29.451Z] <<< [apiv2][body] POST https://firebaserules.googleapis.com/v1/projects/compare-my-trip-8e035/rulesets {"name":"projects/compare-my-trip-8e035/rulesets/d20bbeeb-8495-46d4-855d-fc412e5bb892","source":{"files":[{"content":"rules_version = '2';\n\nservice cloud.firestore {\n  match /databases/{database}/documents {\n    function isAdmin() {\n      return request.auth != null\n        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));\n    }\n\n    match /siteContent/homepage {\n      // Homepage content is public by design; only admins may publish it.\n      allow read: if true;\n      allow write: if isAdmin();\n    }\n\n    match /users/{userId} {\n      allow create, update, delete: if request.auth != null\n        && request.auth.uid == userId;\n      allow get: if (request.auth != null && request.auth.uid == userId)\n        || isAdmin();\n\n      // Customer contact details are visible only to explicitly authorized\n      // CRM accounts, never to every authenticated website customer.\n      allow list: if isAdmin();\n    }\n\n    match /newsletterSubscribers/{subscriberId} {\n      function validSubscription() {\n        return request.resource.data.keys().hasOnly(['email', 'subscribedAt'])\n          && request.resource.data.email is string\n          && request.resource.data.email.size() > 3\n          && request.resource.data.email.size() <= 254\n          && request.resource.data.email.matches('^[^\\\\s@]+@[^\\\\s@]+\\\\.[^\\\\s@]+$')\n          && request.resource.data.subscribedAt == request.time;\n      }\n\n      allow create: if validSubscription();\n      allow update: if validSubscription()\n        && request.resource.data.email == resource.data.email;\n      allow read, delete: if isAdmin();\n    }\n\n    match /contactEnquiries/{enquiryId} {\n      function validNewEnquiry() {\n        return request.resource.data.keys().hasOnly([\n          'name', 'email', 'phone', 'destination', 'departure',\n          'travellers', 'message', 'packageId', 'packageTitle', 'source',\n          'userId', 'status', 'submittedAt'\n        ])\n          && request.resource.data.name is string\n          && request.resource.data.name.size() >= 2\n          && request.resource.data.name.size() <= 120\n          && request.resource.data.email is string\n          && request.resource.data.email.size() <= 254\n          && request.resource.data.email.matches('^[^\\\\s@]+@[^\\\\s@]+\\\\.[^\\\\s@]+$')\n          && request.resource.data.phone is string\n          && request.resource.data.phone.size() >= 7\n          && request.resource.data.phone.size() <= 24\n          && request.resource.data.destination is string\n          && request.resource.data.destination.size() <= 160\n          && request.resource.data.departure is string\n          && request.resource.data.departure.size() <= 20\n          && request.resource.data.travellers is string\n          && request.resource.data.travellers.size() <= 20\n          && request.resource.data.message is string\n          && request.resource.data.message.size() <= 5000\n          && request.resource.data.packageId is string\n          && request.resource.data.packageId.size() <= 180\n          && request.resource.data.packageTitle is string\n          && request.resource.data.packageTitle.size() <= 240\n          && request.resource.data.userId is string\n          && request.resource.data.userId.size() <= 128\n          && request.resource.data.source is string\n          && request.resource.data.source in ['contact', 'custom_quote']\n          && (\n            (request.resource.data.source == 'contact'\n              && request.resource.data.userId == ''\n              && request.resource.data.status == 'not_contacted')\n            ||\n            (request.resource.data.source == 'custom_quote'\n              && request.auth != null\n              && request.resource.data.userId == request.auth.uid\n              && request.resource.data.status == 'under_review')\n          )\n          && request.resource.data.submittedAt == request.time;\n      }\n\n      allow create: if validNewEnquiry();\n      allow read: if isAdmin()\n        || (request.auth != null && resource.data.userId == request.auth.uid);\n      allow update, delete: if isAdmin();\n    }\n\n    match /admins/{adminId} {\n      // Admin membership is provisioned out-of-band in the Firebase console.\n      // Client applications can neither enumerate nor change this collection.\n      allow get: if request.auth != null && request.auth.uid == adminId;\n      allow list, create, update, delete: if false;\n    }\n\n    match /packages/{packageId} {\n      // Package products are public; only admins can manage them.\n      allow read: if true;\n      allow create, update, delete: if isAdmin();\n    }\n\n    match /blogPosts/{postId} {\n      // Travel guides are public content; only admins can write them.\n      // Drafts live in the same collection, so an unpublished post is\n      // readable by anyone who guesses its slug — treat a draft as\n      // \"not linked from the website yet\", not as a secret.\n      allow read: if true;\n      allow create, update, delete: if isAdmin();\n    }\n\n    match /destinationCovers/{destinationId} {\n      // Cover artwork for the public destinations grid. The destinations\n      // themselves are derived from the package catalogue; this only holds\n      // the picture an admin picked for each card.\n      allow read: if true;\n      allow create, update, delete: if isAdmin();\n    }\n\n    match /{document=**} {\n      allow read, write: if false;\n    }\n  }\n}\n","name":"firestore.rules"}]},"createTime":"2026-08-31T03:03:29.198447Z","metadata":{"services":["cloud.firestore"]}}

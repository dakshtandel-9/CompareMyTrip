[debug] [2026-08-30T17:22:34.099Z] <<< [apiv2][body] POST https://firebaserules.googleapis.com/v1/projects/compare-my-trip-8e035/rulesets {"name":"projects/compare-my-trip-8e035/rulesets/dc1c6122-5c30-4d5f-b786-55adc2aaa668","source":{"files":[{"content":"rules_version = '2';\n\nservice cloud.firestore {\n  match /databases/{database}/documents {\n    function isAdmin() {\n      return request.auth != null\n        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));\n    }\n\n    match /siteContent/homepage {\n      // Homepage content is public by design; only admins may publish it.\n      allow read: if true;\n      allow write: if isAdmin();\n    }\n\n    match /users/{userId} {\n      allow create, update, delete: if request.auth != null\n        && request.auth.uid == userId;\n      allow get: if (request.auth != null && request.auth.uid == userId)\n        || isAdmin();\n\n      // Customer contact details are visible only to explicitly authorized\n      // CRM accounts, never to every authenticated website customer.\n      allow list: if isAdmin();\n    }\n\n    match /admins/{adminId} {\n      // Admin membership is provisioned out-of-band in the Firebase console.\n      // Client applications can neither enumerate nor change this collection.\n      allow get: if request.auth != null && request.auth.uid == adminId;\n      allow list, create, update, delete: if false;\n    }\n\n    match /packages/{packageId} {\n      // Package products are public; only admins can manage them.\n      allow read: if true;\n      allow create, update, delete: if isAdmin();\n    }\n\n    match /{document=**} {\n      allow read, write: if false;\n    }\n  }\n}\n","name":"firestore.rules"}]},"createTime":"2026-08-30T17:22:33.978287Z","metadata":{"services":["cloud.firestore"]}}

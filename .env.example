# ---------------------------------------------------------------------------
# PayU (India). Get these from the PayU dashboard → Merchant Key / Salt.
# PAYU_SALT is a server secret: it signs and verifies every payment, so it must
# never be prefixed NEXT_PUBLIC_ or referenced from a client component.
# ---------------------------------------------------------------------------
PAYU_MERCHANT_KEY=
PAYU_SALT=

# "test" (https://test.payu.in) or "live" (https://secure.payu.in).
# Anything other than "live" is treated as test.
PAYU_MODE=test

# Absolute origin used to build PayU's surl/furl. Leave unset locally and the
# request host is used; set it in production so the callback always comes back
# to the right domain.
NEXT_PUBLIC_SITE_URL=https://comparemytrip.in

# Optional launch integrations. Leave blank until the real values are issued.
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# ---------------------------------------------------------------------------
# Firebase (already in use)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# ---------------------------------------------------------------------------
# Cloudflare R2 image storage (server-only; never prefix these with NEXT_PUBLIC)
# ---------------------------------------------------------------------------
# Public base URL for the scroll-frame sequences (hero + train banner).
# ~1400 JPEGs / 132MB, uploaded by scripts/upload-frame-sequences.mjs and
# deliberately NOT kept in the repo. Leave unset to fall back to /public,
# which only works if you have regenerated the frames from /media-source.
NEXT_PUBLIC_FRAME_CDN_URL=

CLOUDFLARE_R2_ACCOUNT_ID=
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
CLOUDFLARE_R2_BUCKET_NAME=comparemytrip-images
# Public bucket URL, for example https://pub-xxxxxxxx.r2.dev
CLOUDFLARE_R2_PUBLIC_URL=

# Google Business Profile → the traveller-reviews rail.
# There is nothing to add here: the OAuth client ID and secret are entered in
# the CRM (Content → Reviews → Google Business Profile) and stored server-side
# in Firestore, deliberately not in this file and never in the public homepage
# document. Two things the integration does depend on:
#   · NEXT_PUBLIC_SITE_URL above — the OAuth redirect URI is built from it, and
#     must match the one registered on the Google OAuth client exactly.
#   · FIREBASE_SERVICE_ACCOUNT_KEY_BASE64 — the Admin SDK is the only thing
#     allowed to read or write the stored credentials.

# Private Cloudflare R2 bucket for temporary quote PDFs. Keep r2.dev and custom
# domains disabled. Must differ from the public image bucket above. Uses the
# same R2 account/access credentials, which need object access to this bucket.
CLOUDFLARE_R2_QUOTE_BUCKET_NAME=
# Random server-only secret. Vercel sends this as a Bearer token to the cron.
CRON_SECRET=
# Required by the server for Firestore enquiry/expiry records (PDFs live in R2).
FIREBASE_SERVICE_ACCOUNT_KEY_BASE64=

# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# scratch / working dirs
/tmp

# video masters used only to generate the frame sequences in public/ —
# never fetched at runtime, kept out of the repo and out of the deploy
/media-source

# the generated frame sequences themselves (~1400 JPEGs, 132MB). They are
# served from R2 — see NEXT_PUBLIC_FRAME_CDN_URL and
# scripts/upload-frame-sequences.mjs — and must never enter the repo or the
# deploy bundle. Regenerate locally from /media-source if you need them.
/public/hero-frames*
/public/train-banner
.env.vercel-check

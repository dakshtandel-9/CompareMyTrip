rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    match /homepage/{imageId} {
      allow read: if true;
      allow write: if request.auth != null
        && request.resource.size < 600 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    match /packages/{imageId} {
      allow read: if true;
      allow write: if request.auth != null
        && request.resource.size < 600 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    match /blog/{imageId} {
      allow read: if true;
      allow write: if request.auth != null
        && request.resource.size < 600 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
